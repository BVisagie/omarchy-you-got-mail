#!/usr/bin/env python3
"""Outlook via Microsoft Graph. IMAP is a separate account with provider=imap."""

from __future__ import annotations

import fcntl
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime
from pathlib import Path

import _bootstrap
from common import (
    FileTooLargeError,
    ResponseTooLargeError,
    account_error,
    die,
    emit,
    load_secret,
    one_line,
    read_http_body,
    read_owned_file,
    save_secret,
    secret_path,
    write_private,
)
from outlook_auth import refresh_access_token

GRAPH = "https://graph.microsoft.com/v1.0"
SKIP_WELL_KNOWN = ("junkemail", "deleteditems", "drafts")
CACHE_TTL = 6 * 3600
READ_ALL_BUDGET = 100
BATCH_SIZE = 20


def _try_http(
    method: str,
    url: str,
    token: str,
    payload: dict | None = None,
    extra_headers: dict[str, str] | None = None,
) -> tuple[dict | None, str]:
    data = None if payload is None else json.dumps(payload).encode()
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", f"Bearer {token}")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    for key, value in (extra_headers or {}).items():
        req.add_header(key, value)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = read_http_body(resp).decode()
            return (json.loads(raw) if raw else {}), ""
    except urllib.error.HTTPError as exc:
        return None, f"Outlook HTTP {exc.code}"
    except urllib.error.URLError:
        return None, "could not reach Microsoft Graph"
    except ResponseTooLargeError:
        return None, "response too large"
    except (json.JSONDecodeError, UnicodeDecodeError):
        return None, "Outlook returned invalid JSON"


def _http(
    method: str,
    url: str,
    token: str,
    payload: dict | None = None,
    extra_headers: dict[str, str] | None = None,
) -> dict:
    data, err = _try_http(method, url, token, payload, extra_headers)
    if err:
        die(err)
    return data or {}


def _cache_dir(account_id: str) -> Path:
    root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy-you-got-mail" / account_id
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    return root


def _read_cache(account_id: str) -> dict:
    path = _cache_dir(account_id) / "outlook.json"
    try:
        raw = read_owned_file(path)
    except (OSError, FileTooLargeError, PermissionError):
        return {}
    if raw is None:
        return {}
    try:
        data = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def _write_cache(account_id: str, data: dict) -> None:
    write_private(_cache_dir(account_id) / "outlook.json", json.dumps(data))


def _outlook_error(account_id: str, raw: str) -> None:
    die(account_error({"id": account_id, "provider": "outlook"}, raw))


def _access(sec: dict, account_id: str) -> str:
    client_id = str(sec.get("client_id") or "")
    refresh = str(sec.get("refresh_token") or "")
    tenant = str(sec.get("tenant") or "common")
    if not client_id or not refresh:
        _outlook_error(account_id, "not signed in")
    now = time.time()
    cached = str(sec.get("access_token") or "")
    expires_at = float(sec.get("access_expires_at") or 0)
    if cached and expires_at > now + 60:
        return cached

    lock_path = secret_path(account_id).with_name(f"{account_id}.lock")
    lock_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        os.fchmod(fd, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
        latest = load_secret(account_id)
        if latest:
            sec = dict(latest)
        client_id = str(sec.get("client_id") or client_id)
        refresh = str(sec.get("refresh_token") or refresh)
        tenant = str(sec.get("tenant") or tenant)
        cached = str(sec.get("access_token") or "")
        expires_at = float(sec.get("access_expires_at") or 0)
        now = time.time()
        if cached and expires_at > now + 60:
            return cached
        if not client_id or not refresh:
            _outlook_error(account_id, "not signed in")
        try:
            tokens = refresh_access_token(client_id, refresh, tenant)
        except RuntimeError as exc:
            _outlook_error(account_id, str(exc))
        sec = dict(sec)
        sec["client_id"] = client_id
        sec["tenant"] = tenant
        sec["access_token"] = str(tokens["access_token"])
        sec["access_expires_at"] = now + int(tokens.get("expires_in") or 3600)
        if tokens.get("refresh_token"):
            sec["refresh_token"] = tokens["refresh_token"]
        save_secret(account_id, sec)
        return str(sec["access_token"])
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        os.close(fd)


def _skip_folders(token: str, account_id: str, cache: dict) -> tuple[set[str], dict]:
    cached_skip = cache.get("skip_ids")
    cached_at = float(cache.get("skip_at") or 0)
    if isinstance(cached_skip, list) and time.time() - cached_at < CACHE_TTL:
        return set(str(x) for x in cached_skip), cache
    skip = set()
    for well_known in SKIP_WELL_KNOWN:
        data = _http("GET", f"{GRAPH}/me/mailFolders/{well_known}", token)
        if data.get("id"):
            skip.add(str(data["id"]))
    cache = dict(cache)
    cache["skip_ids"] = sorted(skip)
    cache["skip_at"] = time.time()
    _write_cache(account_id, cache)
    return skip, cache


def _profile(token: str, account_id: str, cache: dict) -> tuple[str, dict]:
    email = str(cache.get("email") or "")
    cached_at = float(cache.get("email_at") or 0)
    if email and time.time() - cached_at < CACHE_TTL:
        return email, cache
    me = _http("GET", f"{GRAPH}/me?$select=mail,userPrincipalName", token)
    email = str(me.get("mail") or me.get("userPrincipalName") or "")
    cache = dict(cache)
    cache["email"] = email
    cache["email_at"] = time.time()
    _write_cache(account_id, cache)
    return email, cache


def _folder_unread_total(token: str, skip: set[str]) -> int:
    total = 0

    def walk(url: str) -> None:
        nonlocal total
        while url:
            data = _http("GET", url, token)
            for folder in data.get("value") or []:
                fid = str(folder.get("id") or "")
                if not fid or fid in skip:
                    continue
                total += int(folder.get("unreadItemCount") or 0)
                child = (
                    f"{GRAPH}/me/mailFolders/{urllib.parse.quote(fid)}"
                    "/childFolders?$select=id,unreadItemCount&$top=100"
                )
                walk(child)
            url = str(data.get("@odata.nextLink") or "")

    walk(f"{GRAPH}/me/mailFolders?$select=id,unreadItemCount&$top=100")
    return total


def cmd_list(acc: dict, sec: dict, limit: int) -> None:
    account_id = str(acc.get("id") or "outlook")
    token = _access(sec, account_id)
    cache = _read_cache(account_id)
    skip, cache = _skip_folders(token, account_id, cache)
    email, cache = _profile(token, account_id, cache)
    params = {
        "$filter": "isRead eq false",
        "$select": "id,subject,from,bodyPreview,receivedDateTime,webLink,parentFolderId,conversationId",
        "$orderby": "receivedDateTime desc",
        "$top": str(limit),
    }
    url = f"{GRAPH}/me/messages?" + urllib.parse.urlencode(params)
    data = _http("GET", url, token)
    personal = email.lower().endswith(
        ("@outlook.com", "@hotmail.com", "@live.com", "@msn.com")
    )
    search_url = (
        "https://outlook.live.com/mail/inbox"
        if personal
        else "https://outlook.office.com/mail/inbox"
    )
    fallback_url = (
        "https://outlook.live.com/mail/"
        if personal
        else "https://outlook.office.com/mail/"
    )
    messages = []
    for item in data.get("value") or []:
        if item.get("parentFolderId") in skip:
            continue
        from_obj = (item.get("from") or {}).get("emailAddress") or {}
        name = from_obj.get("name") or from_obj.get("address") or ""
        received = item.get("receivedDateTime") or ""
        ts = 0
        if received:
            try:
                ts = int(datetime.fromisoformat(received.replace("Z", "+00:00")).timestamp())
            except ValueError:
                ts = 0
        messages.append(
            {
                "id": item["id"],
                "threadId": item.get("conversationId") or item["id"],
                "subject": one_line(item.get("subject") or "") or "(no subject)",
                "from": one_line(str(name)),
                "snippet": one_line(item.get("bodyPreview") or ""),
                "ts": ts,
                "labels": [],
                "url": item.get("webLink") or fallback_url,
            }
        )
        if len(messages) >= limit:
            break
    unread = _folder_unread_total(token, skip)
    emit(
        {
            "ok": True,
            "email": email,
            "unread": max(unread, len(messages)),
            "searchUrl": search_url,
            "messages": messages,
        }
    )


def cmd_read(acc: dict, sec: dict, item_id: str) -> None:
    token = _access(sec, str(acc.get("id") or "outlook"))
    _http(
        "PATCH",
        f"{GRAPH}/me/messages/{urllib.parse.quote(item_id, safe='')}",
        token,
        {"isRead": True},
    )
    emit({"ok": True})


def _chunked(items: list[str], size: int) -> list[list[str]]:
    if size < 1:
        size = 1
    return [items[i : i + size] for i in range(0, len(items), size)]


def _unread_folder_ids(token: str, skip: set[str]) -> list[str]:
    ids: list[str] = []

    def walk(url: str) -> None:
        while url:
            data = _http("GET", url, token)
            for folder in data.get("value") or []:
                fid = str(folder.get("id") or "")
                if not fid or fid in skip:
                    continue
                ids.append(fid)
                child = (
                    f"{GRAPH}/me/mailFolders/{urllib.parse.quote(fid)}"
                    "/childFolders?$select=id,unreadItemCount&$top=100"
                )
                walk(child)
            url = str(data.get("@odata.nextLink") or "")

    walk(f"{GRAPH}/me/mailFolders?$select=id,unreadItemCount&$top=100")
    return ids


def _unread_message_ids(token: str, folder_id: str) -> list[str]:
    ids: list[str] = []
    seen: set[str] = set()
    params = {
        "$filter": "isRead eq false",
        "$select": "id",
        "$top": "100",
    }
    url = (
        f"{GRAPH}/me/mailFolders/{urllib.parse.quote(folder_id, safe='')}/messages?"
        + urllib.parse.urlencode(params)
    )
    while url:
        data = _http("GET", url, token)
        for item in data.get("value") or []:
            mid = str(item.get("id") or "")
            if not mid or mid in seen:
                continue
            seen.add(mid)
            ids.append(mid)
        url = str(data.get("@odata.nextLink") or "")
    return ids


def _batch_mark_read(token: str, ids: list[str], deadline: float) -> tuple[int, str]:
    marked = 0
    for chunk in _chunked(ids, BATCH_SIZE):
        if time.monotonic() > deadline:
            return marked, "timed out marking mail as read"
        requests = []
        for n, mid in enumerate(chunk):
            requests.append(
                {
                    "id": str(n),
                    "method": "PATCH",
                    "url": "/me/messages/" + urllib.parse.quote(mid, safe=""),
                    "headers": {"Content-Type": "application/json"},
                    "body": {"isRead": True},
                }
            )
        data, err = _try_http("POST", f"{GRAPH}/$batch", token, {"requests": requests})
        if err or not data:
            return marked, err or "could not mark as read"
        by_id = {str(r.get("id")): r for r in (data.get("responses") or []) if isinstance(r, dict)}
        failed = False
        for n, _mid in enumerate(chunk):
            resp = by_id.get(str(n)) or {}
            try:
                status = int(resp.get("status") or 0)
            except (TypeError, ValueError):
                status = 0
            if 200 <= status < 300:
                marked += 1
            else:
                failed = True
        if failed:
            return marked, "could not mark as read"
    return marked, ""


def cmd_read_all(acc: dict, sec: dict) -> None:
    token = _access(sec, str(acc.get("id") or "outlook"))
    cache = _read_cache(str(acc.get("id") or "outlook"))
    skip, _cache = _skip_folders(token, str(acc.get("id") or "outlook"), cache)
    deadline = time.monotonic() + READ_ALL_BUDGET
    collected: list[str] = []
    seen: set[str] = set()
    for folder_id in _unread_folder_ids(token, skip):
        if time.monotonic() > deadline:
            emit({"ok": False, "marked": 0, "error": "timed out collecting unread mail"})
            return
        for mid in _unread_message_ids(token, folder_id):
            if mid in seen:
                continue
            seen.add(mid)
            collected.append(mid)
    marked, err = _batch_mark_read(token, collected, deadline)
    if err:
        emit({"ok": False, "marked": marked, "error": err})
        return
    emit({"ok": True, "marked": marked})


def main() -> None:
    acc = _bootstrap.account()
    sec = _bootstrap.secret()
    cmd, rest, flags = _bootstrap.parse_args(sys.argv[1:])
    limit = _bootstrap.list_limit(flags)
    if cmd == "list":
        cmd_list(acc, sec, limit)
        return
    if cmd == "read":
        if not rest:
            die("usage: outlook read <id>")
        cmd_read(acc, sec, rest[0])
        return
    if cmd == "read-all":
        cmd_read_all(acc, sec)
        return
    die("unknown command")


if __name__ == "__main__":
    _bootstrap.run(main)
