#!/usr/bin/env python3
"""HEY provider, via https://github.com/basecamp/hey-cli.

Auth lives in hey-cli (`hey auth login`). Unseen Imbox threads are the
unread pile — HEY's Feed, Paper Trail, and Screener are not treated as
unread. Same command surface as the official Omarchy HEY plugin:

  hey box imbox --account all --limit N --json
  hey seen <posting-id> --json
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
from datetime import datetime

import _bootstrap
from common import die, emit, one_line

HEY_WEB = "https://app.hey.com"
READ_ALL_BUDGET = 100
HEY_PAGE_LIMIT = 50


def _hey_env(acc: dict) -> dict:
    env = os.environ.copy()
    env["HEY_NONINTERACTIVE"] = "1"
    env["NO_COLOR"] = "1"
    extra = [
        os.path.expanduser("~/.local/share/mise/shims"),
        os.path.expanduser("~/.local/bin"),
        os.path.expanduser("~/.bun/bin"),
    ]
    path = env.get("PATH", "")
    for d in extra:
        if os.path.isdir(d) and d not in path.split(":"):
            path = f"{path}:{d}"
    env["PATH"] = path
    hey_acc = str(acc.get("hey_account") or os.environ.get("HEY_ACCOUNT_ID") or "")
    if hey_acc:
        env["HEY_ACCOUNT_ID"] = hey_acc
    return env


def _account_flag(acc: dict, extra: str = "") -> list[str]:
    hey_acc = str(extra or acc.get("hey_account") or "").strip()
    if hey_acc:
        return ["--account", hey_acc]
    return ["--account", "all"]


def _hey(acc: dict, args: list[str], timeout: int = 40) -> dict:
    payload, err = _try_hey(acc, args, timeout=timeout)
    if err:
        die(err)
    return payload or {}


def _try_hey(acc: dict, args: list[str], timeout: int = 40) -> tuple[dict | None, str]:
    env = _hey_env(acc)
    if not shutil.which("hey", path=env.get("PATH")):
        return None, (
            "hey-cli not found. Install with: omarchy-mise-install github:basecamp/hey-cli hey"
        )
    cmd = ["hey", *args, "--json"]
    try:
        proc = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            env=env,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return None, "hey timed out"
    stdout = (proc.stdout or "").strip()
    stderr = (proc.stderr or "").strip()
    payload = _parse_json(stdout) or _parse_json(stderr)
    if isinstance(payload, dict) and payload.get("ok") is False:
        return None, _hey_error_message(payload, proc.returncode)
    if proc.returncode != 0 or not isinstance(payload, dict):
        return None, _hey_failure_message(stdout, stderr, proc.returncode)
    return payload, ""


def _parse_json(text: str) -> dict | None:
    if not text:
        return None
    for candidate in (text, text.splitlines()[-1]):
        try:
            payload = json.loads(candidate)
        except json.JSONDecodeError:
            continue
        if isinstance(payload, dict):
            return payload
    return None


def _hey_error_message(payload: dict, returncode: int) -> str:
    code = str(payload.get("code") or "")
    msg = str(payload.get("error") or payload.get("message") or "hey failed")
    if (
        returncode == 3
        or code in ("auth", "auth_required")
        or "not logged in" in msg.lower()
    ):
        return "HEY is not signed in; run: hey auth login"
    return msg


def _hey_failure_message(stdout: str, stderr: str, returncode: int) -> str:
    err = stderr or stdout
    if returncode == 3 or "not logged in" in err.lower():
        return "HEY is not signed in; run: hey auth login"
    return err or "hey returned no output"


def _die_hey_error(payload: dict, returncode: int) -> None:
    die(_hey_error_message(payload, returncode))


def _die_hey_failure(stdout: str, stderr: str, returncode: int) -> None:
    die(_hey_failure_message(stdout, stderr, returncode))


def _data(payload: dict) -> dict:
    data = payload.get("data")
    return data if isinstance(data, dict) else payload


def _ts(value: str) -> int:
    if not value:
        return 0
    try:
        return int(datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp())
    except ValueError:
        return 0


def _from(posting: dict) -> str:
    alt = str(posting.get("alternative_sender_name") or "").strip()
    if alt:
        return alt
    creator = posting.get("creator")
    if isinstance(creator, dict):
        name = str(creator.get("name") or creator.get("email_address") or "").strip()
        if name:
            return name
    contacts = posting.get("contacts") or []
    if contacts and isinstance(contacts[0], dict):
        return str(contacts[0].get("name") or contacts[0].get("email") or "")
    return ""


def _url(posting: dict) -> str:
    raw = str(posting.get("app_url") or posting.get("url") or "").strip()
    if raw.startswith("https://app.hey.com"):
        return raw
    if raw.startswith("/"):
        return HEY_WEB + raw
    topic = posting.get("topic_id")
    if topic:
        return f"{HEY_WEB}/topics/{topic}"
    return HEY_WEB


def _local_id(posting: dict) -> str:
    posting_id = str(posting.get("id") or "").strip()
    account_id = str(posting.get("account_id") or "").strip()
    if posting_id and account_id:
        return f"{posting_id}+{account_id}"
    return posting_id


def _split_local_id(local_id: str) -> tuple[str, str]:
    if "+" in local_id:
        posting_id, account_id = local_id.split("+", 1)
        return posting_id, account_id
    return local_id, ""


def _next_page(payload: dict, box: dict) -> str:
    meta = payload.get("meta") if isinstance(payload.get("meta"), dict) else {}
    for source in (box, payload, meta):
        if not isinstance(source, dict):
            continue
        for key in ("next_page", "nextPage"):
            value = str(source.get(key) or "").strip()
            if value:
                return value
    return ""


def _envelope_unread(payload: dict, box: dict) -> int | None:
    meta = payload.get("meta") if isinstance(payload.get("meta"), dict) else {}
    for source in (box, payload, meta):
        if not isinstance(source, dict):
            continue
        for key in ("unseen_count", "unseenCount", "new_count", "newCount"):
            raw = source.get(key)
            if raw is None:
                continue
            try:
                return max(0, int(raw))
            except (TypeError, ValueError):
                continue
    return None


def cmd_list(acc: dict, limit: int) -> None:
    unseen: list[dict] = []
    unread = 0
    search_url = HEY_WEB
    page = ""
    counted_from_envelope = None
    for _ in range(20):
        args = ["box", "imbox", *_account_flag(acc), "--limit", str(max(limit, 50))]
        if page:
            args.extend(["--page", page])
        payload = _hey(acc, args)
        box = _data(payload)
        raw_url = str(box.get("app_url") or search_url)
        if raw_url.startswith("/"):
            raw_url = HEY_WEB + raw_url
        if raw_url.startswith("https://"):
            search_url = raw_url
        if counted_from_envelope is None:
            counted_from_envelope = _envelope_unread(payload, box)
        for item in box.get("postings") or []:
            if not isinstance(item, dict) or item.get("seen") is True:
                continue
            posting_id = _local_id(item)
            if not posting_id:
                continue
            unread += 1
            if len(unseen) >= limit:
                continue
            unseen.append(
                {
                    "id": posting_id,
                    "threadId": str(item.get("topic_id") or item.get("id") or posting_id),
                    "subject": one_line(item.get("name") or "") or "(no subject)",
                    "from": one_line(_from(item)),
                    "snippet": one_line(item.get("summary") or ""),
                    "ts": _ts(
                        str(
                            item.get("active_at")
                            or item.get("updated_at")
                            or item.get("created_at")
                            or ""
                        )
                    ),
                    "labels": ["Imbox"],
                    "url": _url(item),
                }
            )
        page = _next_page(payload, box)
        if not page:
            break
        if counted_from_envelope is not None and len(unseen) >= limit:
            break
    if counted_from_envelope is not None:
        unread = max(counted_from_envelope, unread)
    emit(
        {
            "ok": True,
            "email": str(acc.get("email") or acc.get("label") or "HEY"),
            "unread": unread,
            "searchUrl": search_url if search_url.startswith("https://") else HEY_WEB,
            "messages": unseen[:limit],
        }
    )


def cmd_read(acc: dict, local_id: str) -> None:
    posting_id, account_id = _split_local_id(local_id)
    if not posting_id:
        die("usage: hey read <id>")
    args = ["seen", posting_id, *_account_flag(acc, account_id)]
    _hey(acc, args)
    emit({"ok": True})


def _collect_unseen(acc: dict, deadline: float) -> list[str]:
    collected: list[str] = []
    seen_ids: set[str] = set()
    seen_pages: set[str] = set()
    page = ""
    for _ in range(1000):
        if time.monotonic() > deadline:
            die("timed out collecting unread mail")
        args = ["box", "imbox", *_account_flag(acc), "--limit", str(HEY_PAGE_LIMIT)]
        if page:
            if page in seen_pages:
                die("hey repeated a page token")
            seen_pages.add(page)
            args.extend(["--page", page])
        payload = _hey(acc, args)
        box = _data(payload)
        for item in box.get("postings") or []:
            if not isinstance(item, dict) or item.get("seen") is True:
                continue
            local_id = _local_id(item)
            if not local_id or local_id in seen_ids:
                continue
            seen_ids.add(local_id)
            collected.append(local_id)
        next_page = _next_page(payload, box)
        if not next_page:
            break
        if next_page == page:
            die("hey repeated a page token")
        page = next_page
    return collected


def cmd_read_all(acc: dict) -> None:
    deadline = time.monotonic() + READ_ALL_BUDGET
    collected = _collect_unseen(acc, deadline)
    marked = 0
    for local_id in collected:
        if time.monotonic() > deadline:
            emit({"ok": False, "marked": marked, "error": "timed out marking mail as read"})
            return
        posting_id, account_id = _split_local_id(local_id)
        if not posting_id:
            continue
        payload, err = _try_hey(
            acc,
            ["seen", posting_id, *_account_flag(acc, account_id)],
            timeout=15,
        )
        if err or payload is None:
            emit({"ok": False, "marked": marked, "error": err or "could not mark as read"})
            return
        marked += 1
    emit({"ok": True, "marked": marked})


def main() -> None:
    acc = _bootstrap.account()
    cmd, rest, flags = _bootstrap.parse_args(sys.argv[1:])
    limit = _bootstrap.list_limit(flags)
    if cmd == "list":
        cmd_list(acc, limit)
        return
    if cmd == "read":
        if not rest:
            die("usage: hey read <id>")
        cmd_read(acc, rest[0])
        return
    if cmd == "read-all":
        cmd_read_all(acc)
        return
    die("unknown command")


if __name__ == "__main__":
    _bootstrap.run(main)
