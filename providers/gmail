#!/usr/bin/env bash
# Gmail provider for You've Got Mail.
#
# Unread anywhere except spam, trash and drafts. Skip-inbox labels are
# included because they are just unread mail that is not in INBOX.
#
#   gmail list [--page TOKEN]
#   gmail read <id>
#   gmail read-all
#
# gws owns the OAuth token. This script never sees a credential.

set -uo pipefail
umask 077

export GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND="${GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND:-file}"

# Most gws output this provider reads; a larger reply is refused, not parsed.
export GWS_MAX_BYTES=$((8 * 1024 * 1024))
# The message cache keeps 1000 entries of a few kilobytes each.
CACHE_MAX_BYTES=$((8 * 1024 * 1024))

for candidate in "$HOME/.local/share/mise/shims" "$HOME/.local/bin" "$HOME/.bun/bin"; do
  case ":$PATH:" in
    *":$candidate:"*) ;;
    *) [ -d "$candidate" ] && PATH="$PATH:$candidate" ;;
  esac
done
export PATH

# Inbox unread, plus unread on labels you created (including skip-inbox).
# Gmail's UNREAD system label also covers trash and archived tab mail
# (Promotions/Updates with no user label) that the web UI does not show as
# unread in Inbox or the label list — that is not part of this pile.
QUERY="is:unread -in:spam -in:trash -in:drafts -in:chats (in:inbox OR has:userlabels)"

ACCOUNT_ID="${YOU_GOT_MAIL_ACCOUNT_ID:-gmail}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-you-got-mail/${ACCOUNT_ID}"
CACHE_FILE="$CACHE_DIR/messages.json"
PROFILE_FILE="$CACHE_DIR/profile.json"
LABEL_FILE="$CACHE_DIR/labels.json"

die() {
  printf '{"ok":false,"error":%s}\n' "$(printf '%s' "$1" | jq -Rs .)"
  exit 0
}

# The command to paste into a terminal. The plugin never puts you-got-mail
# on PATH, so the short name is only used when it resolves to this plugin.
login_hint() {
  local root script found home
  root="${YOU_GOT_MAIL_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
  script="$root/bin/you-got-mail"
  found="$(command -v you-got-mail 2>/dev/null)"
  if [ -n "$found" ] && [ "$(readlink -f -- "$found")" = "$(readlink -f -- "$script")" ]; then
    printf 'you-got-mail accounts login %q' "$ACCOUNT_ID"
    return
  fi
  home="${HOME%/}"
  if [ -n "$home" ] && [[ "$script" == "$home"/* ]]; then
    printf '%s/%q accounts login %q' '~' "${script#"$home"/}" "$ACCOUNT_ID"
  else
    printf '%q accounts login %q' "$script" "$ACCOUNT_ID"
  fi
}

gmail_error() {
  local raw="${1:-could not read unread mail}"
  local lower
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  if [[ "$lower" == *invalid_grant* \
     || "$lower" == *"token has been expired or revoked"* \
     || "$lower" == *"has been expired"* \
     || "$lower" == *"authentication failed"* \
     || "$lower" == *"failed to get token"* \
     || "$lower" == *unauthenticated* \
     || "$lower" == *unauthorized* ]]; then
    die "Gmail needs you to sign in again. In a terminal: $(login_hint)"
  fi
  die "$raw"
}

write_private() {
  local dest="$1" tmp
  tmp="$(mktemp "$dest.XXXXXX" 2>/dev/null)" || return 1
  chmod 600 -- "$tmp" 2>/dev/null
  cat > "$tmp" || { rm -f -- "$tmp"; return 1; }
  mv -f -- "$tmp" "$dest" || { rm -f -- "$tmp"; return 1; }
}

readable_file() {
  [ -f "$1" ] && [ ! -L "$1" ]
}

max_messages() {
  local value="${YOU_GOT_MAIL_MAX:-25}"
  case "$value" in
    ''|*[!0-9]*) printf '25'; return 0 ;;
  esac
  [ "${#value}" -le 3 ] || { printf '25'; return 0; }
  local n=$((10#$value))
  [ "$n" -ge 1 ] || { printf '25'; return 0; }
  [ "$n" -le 200 ] || { printf '200'; return 0; }
  printf '%s' "$n"
}

valid_id() {
  [[ "$1" =~ ^[0-9a-f]{1,32}$ ]]
}

private_dir() {
  local dir="$1" owner
  # umask 077 already makes new parents 700; -m with -p would not.
  mkdir -p -- "$dir" 2>/dev/null
  [[ -d "$dir" && ! -L "$dir" ]] || return 1
  owner="$(stat -c '%u' -- "$dir" 2>/dev/null)" || return 1
  [[ "$owner" == "$(id -u)" ]] || return 1
  chmod 700 -- "$dir" 2>/dev/null || return 1
  find "$dir" -mindepth 1 -maxdepth 1 ! -type f -exec rm -rf -- {} + 2>/dev/null
  # Another run's gws.<pid>.* files come and go; umask 077 made them private.
  find "$dir" -mindepth 1 -maxdepth 1 -type f ! -name 'gws.*.*' -exec chmod 600 -- {} + 2>/dev/null
}

command -v jq >/dev/null 2>&1 || die "jq not found on PATH"
command -v gws >/dev/null 2>&1 || die "Gmail isn't installed for this bar. See the setup guide."
private_dir "$CACHE_DIR" || die "cache directory is not usable"

# Marked when any gws reply in this run is over the cap. $$ stays this run's
# id inside $(...), so a lookup in a subshell can still mark it.
# Each run keeps its working files as gws.<pid>.* in the cache folder. They
# are plain files, which private_dir leaves alone, so runs can overlap.
RUN_FILES="$CACHE_DIR/gws.$$"
TOO_LARGE="$RUN_FILES.too-large"
REPLY_FILE="$RUN_FILES.reply"
# A run stopped at its timeout cannot clean up after itself; the next run
# removes what runs that have ended left behind.
for left in "$CACHE_DIR"/gws.*.*; do
  [ -f "$left" ] || continue
  owner="${left#"$CACHE_DIR"/gws.}"
  owner="${owner%%.*}"
  case "$owner" in ''|*[!0-9]*) continue ;; esac
  kill -0 "$owner" 2>/dev/null || rm -f -- "$left"
done
# Files under this run's own PID can only be an ended run's.
rm -f -- "$RUN_FILES".*
trap 'rm -f -- "$RUN_FILES".*' EXIT

# gws output, capped. The size is counted on the bytes as written, before a
# command substitution can strip trailing newlines. A reply over the cap
# prints nothing, fails, and marks TOO_LARGE for fail_if_too_large.
gws_gmail() {
  local rc saved
  gws gmail "$@" | head -c "$((GWS_MAX_BYTES + 1))" >"$REPLY_FILE"
  rc=${PIPESTATUS[0]} saved=${PIPESTATUS[1]}
  # A reply that could not be saved whole (a full disk) is no reply.
  if [ "$saved" -ne 0 ]; then
    rm -f -- "$REPLY_FILE"
    return "$NOT_SAVED"
  fi
  if [ "$(wc -c <"$REPLY_FILE")" -gt "$GWS_MAX_BYTES" ]; then
    rm -f -- "$REPLY_FILE"
    # Without the mark the oversize would pass for an optional lookup failing.
    : >"$TOO_LARGE" || return "$NOT_SAVED"
    return 1
  fi
  cat -- "$REPLY_FILE"
  rm -f -- "$REPLY_FILE"
  return "$rc"
}

# Returned when a reply or cache file could not be written (a full disk).
# It survives $(...) and pipes (pipefail), so a lookup in a subshell can
# still fail the check instead of passing for "no answer".
NOT_SAVED=75
fail_not_saved() {
  gmail_error "could not write to the Gmail cache"
}

fail_if_too_large() {
  [ -e "$TOO_LARGE" ] && gmail_error "gws sent more output than expected"
  return 0
}

# Write JSON into the caller's variable. Do not invoke this (or unread_total)
# inside $(...): die() exits 0, so a subshell would capture the error object
# and the parent would treat it as an empty mailbox.
gws_list() {
  local dest="$1" errfile="$CACHE_DIR/gws.err" out msg
  shift
  [[ "$dest" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "internal error"
  out="$(gws_gmail "$@" 2>"$errfile")"
  [ "$?" -eq "$NOT_SAVED" ] && fail_not_saved
  fail_if_too_large
  # Exactly one JSON object; a reply holding several is not a page.
  if printf '%s' "$out" | jq -e -s 'length == 1 and (.[0] | type) == "object"' >/dev/null 2>&1; then
    if printf '%s' "$out" | jq -e '.error' >/dev/null 2>&1; then
      gmail_error "$(printf '%s' "$out" | jq -r '.error.message // "could not read unread mail" | tostring | .[0:500]')"
    fi
    printf -v "$dest" '%s' "$out"
    return 0
  fi
  msg="$(head -c 65536 "$errfile" 2>/dev/null | tr -s '[:space:]' ' ')"
  [ -n "$msg" ] || msg="$(tr -s '[:space:]' ' ' <<<"$out")"
  gmail_error "${msg:-could not read unread mail}"
}

ensure_json_object() {
  local file="$1"
  # Measured before jq reads it: a cache grown by an older version without
  # these limits starts over instead of being parsed.
  readable_file "$file" && [ "$(wc -c <"$file")" -le "$CACHE_MAX_BYTES" ] \
    && jq -e 'type == "object"' -- "$file" >/dev/null 2>&1 && return 0
  printf '{}\n' | write_private "$file" || fail_not_saved
}

# An address the links can carry: one line, no spaces or control characters,
# at most 254 characters. Checked in jq on the JSON string itself, before
# bash could drop a NUL or a trailing newline, and again here.
EMAIL_FILTER='.emailAddress | strings
  | select(length >= 1 and length <= 254 and (test("[\\s[:cntrl:]]") | not))'
usable_email() {
  [[ "$1" =~ ^[^[:space:][:cntrl:]]{1,254}$ ]]
}

account_email() {
  local cached email
  # Measured before jq reads it, like the other cache files.
  if readable_file "$PROFILE_FILE" && [ "$(wc -c <"$PROFILE_FILE")" -le 4096 ]; then
    cached="$(jq -r "$EMAIL_FILTER" "$PROFILE_FILE" 2>/dev/null)"
    usable_email "$cached" && { printf '%s' "$cached"; return 0; }
  fi
  email="$(gws_gmail users getProfile --params '{"userId":"me"}' 2>/dev/null \
    | jq -r "$EMAIL_FILTER" 2>/dev/null)"
  [ "$?" -eq "$NOT_SAVED" ] && return "$NOT_SAVED"
  usable_email "$email" || return 1
  printf '{"emailAddress":%s}\n' "$(printf '%s' "$email" | jq -Rs .)" \
    | write_private "$PROFILE_FILE" || return "$NOT_SAVED"
  printf '%s' "$email"
}

search_url() {
  local email="$1"
  local q
  q="$(jq -rn --arg q "$QUERY" '$q | @uri')"
  if [[ "$email" =~ ^[A-Za-z0-9._+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]]; then
    printf 'https://mail.google.com/mail/u/0/?authuser=%s#search/%s' \
      "$(printf '%s' "$email" | jq -Rr @uri)" "$q"
  else
    printf 'https://mail.google.com/mail/u/0/#search/%s' "$q"
  fi
}

message_url() {
  local email="$1" thread="$2"
  if [[ "$email" =~ ^[A-Za-z0-9._+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]]; then
    printf 'https://mail.google.com/mail/u/0/?authuser=%s#all/%s' \
      "$(printf '%s' "$email" | jq -Rr @uri)" "$thread"
  else
    printf 'https://mail.google.com/mail/u/0/#all/%s' "$thread"
  fi
}

# Gmail's size estimate is a coarse bucket (often 201) and is not a
# mailbox total. When the display page already holds every match, `listed`
# is exact. Otherwise count ids with one extra list (API max 500).
unread_total() {
  local dest="$1" listed="$2" next="$3" token="$4" page ids
  [[ "$dest" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "internal error"
  if [ -z "$token" ] && [ -z "$next" ]; then
    printf -v "$dest" '%s' "$listed"
    return 0
  fi
  gws_list page users messages list --params "$(
    jq -nc --arg q "$QUERY" --argjson n 500 \
      '{userId:"me",q:$q,maxResults:$n}')"
  ids="$(printf '%s' "$page" | jq '[.messages[]? | objects | .id | strings | select(test("\\A[0-9a-f]{1,32}\\z"))] | length' 2>/dev/null)"
  case "$ids" in
    ''|*[!0-9]*) printf -v "$dest" '%s' "$listed" ;;
    *) printf -v "$dest" '%s' "$ids" ;;
  esac
}

fill_labels_from_cache() {
  local ids unknown fetched
  ids="$1"

  unknown="$(jq -r --slurpfile cache "$CACHE_FILE" --slurpfile map "$LABEL_FILE" '
      [ .[] | $cache[0][.].lab // [] | .[] ]
      | map(select($map[0][.] == null))
      | length
    ' <<<"$ids" 2>/dev/null)"
  case "$unknown" in ''|*[!0-9]*) return 0 ;; 0) return 0 ;; esac

  fetched="$(gws_gmail users labels list --params '{"userId":"me"}' 2>/dev/null \
    | jq -c '[.labels[]? | select(.type == "user")
              | {key: .id, value: (.name | split("/") | last)}] | from_entries' 2>/dev/null)"
  [ "$?" -eq "$NOT_SAVED" ] && return "$NOT_SAVED"
  [ -n "$fetched" ] || return 0
  printf '%s\n' "$fetched" | write_private "$LABEL_FILE" || return "$NOT_SAVED"
}

fill_cache() {
  local ids missing parts_prefix="$RUN_FILES.part" id
  missing="$(jq -r --slurpfile cache "$CACHE_FILE" '
      .[] | select($cache[0][.] == null)
    ' <<<"$1" 2>/dev/null)"
  [ -n "$missing" ] || return 0

  # Single-quoted so this shell does not expand $1/$id; xargs passes them in.
  # shellcheck disable=SC2016
  local fetch_one='
      id="$1"
      out="$2.$1"
      too_large="$3"
      params=$(jq -nc --arg id "$id" \
        "{userId:\"me\",id:\$id,format:\"metadata\",metadataHeaders:[\"Subject\",\"From\"]}")
      # A part that cannot be saved (a full disk) fails the worker, and
      # with it the check, rather than leaving the message without details.
      gws gmail users messages get --params "$params" 2>/dev/null \
        | head -c "$((GWS_MAX_BYTES + 1))" > "$out.raw" || exit 1
      if [ "$(wc -c < "$out.raw")" -gt "$GWS_MAX_BYTES" ]; then
        rm -f "$out.raw"
        : > "$too_large" || exit 1
        exit 0
      fi
      # Each field is cut here, so a part stays a few kilobytes and the merge
      # of a full page stays small whatever gws sent.
      # Exactly one object, for the message asked about; anything else is
      # treated as no details.
      parsed=$(jq -c -s --arg id "$id" "select(length == 1 and (.[0] | type) == \"object\"
            and (.[0].id | tostring) == \$id) | .[0] | {(\$id): {
              subject: ((.payload.headers // [] | map(select(.name == \"Subject\")) | .[0].value) // \"\" | tostring | .[0:1000]),
              from: ((.payload.headers // [] | map(select(.name == \"From\")) | .[0].value) // \"\" | tostring | .[0:1000]),
              snippet: (.snippet // \"\" | tostring | .[0:1000]),
              ts: ((.internalDate // \"0\") | tostring
                   | if test(\"^[0-9]{1,16}$\") then tonumber else 0 end),
              threadId: (.threadId // .id | tostring | .[0:64]),
              lab: [(.labelIds // [])[] | strings | select(startswith(\"Label_\")) | .[0:64]][0:50]
            }}" < "$out.raw" 2>/dev/null)
      rm -f "$out.raw"
      [ -n "$parsed" ] || exit 0
      printf "%s\n" "$parsed" > "$out.json" || exit 1
    '

  while IFS= read -r id; do
    valid_id "$id" || continue
    printf '%s\n' "$id"
  done <<<"$missing" | xargs -r -P 6 -I {} bash -c "$fetch_one" _ {} "$parts_prefix" "$TOO_LARGE"
  if [ "${PIPESTATUS[1]}" -ne 0 ]; then
    rm -f -- "$parts_prefix".*
    gmail_error "could not save message details"
  fi

  fail_if_too_large

  shopt -s nullglob
  local parts=("$parts_prefix".*.json)
  if (( ${#parts[@]} > 0 )); then
    local merged
    merged="$(jq -s '
        (.[0] // {}) as $old
        | reduce .[1:][] as $entry ($old; . + $entry)
        | to_entries
        | sort_by(-(.value.ts // 0))
        | .[0:1000]
        | from_entries
      ' "$CACHE_FILE" "${parts[@]}" 2>/dev/null)"
    if [ -z "$merged" ] || ! printf '%s\n' "$merged" | write_private "$CACHE_FILE"; then
      rm -f -- "$parts_prefix".*
      gmail_error "could not save message details"
    fi
  fi
  shopt -u nullglob

  rm -f -- "$parts_prefix".*
}

render() {
  local ids="$1" unread="$2" email="$3" next="$4" current="$5"
  local search
  search="$(search_url "$email")"

  jq -nc \
    --argjson ids "$ids" \
    --slurpfile cache "$CACHE_FILE" \
    --slurpfile labelmap "$LABEL_FILE" \
    --argjson unread "$unread" \
    --arg email "$email" \
    --arg next "$next" \
    --arg current "$current" \
    --arg search "$search" \
    --arg authuser "$email" '
    def entity:
      gsub("&lt;";"<") | gsub("&gt;";">") | gsub("&quot;";"\"")
      | gsub("&#39;";"'"'"'") | gsub("&nbsp;";" ") | gsub("&amp;";"&")
      | gsub("[\\r\\n\\t]+"; " ") | gsub(" +"; " ")
      | ltrimstr(" ") | rtrimstr(" ");

    def sender:
      . as $raw
      | (capture("^\\s*\"?(?<name>[^\"<]*?)\"?\\s*<(?<addr>[^>]+)>\\s*$") // null) as $m
      | if $m == null then ($raw | ltrimstr(" ") | rtrimstr(" "))
        elif ($m.name | length) > 0 then $m.name
        else $m.addr end;

    def mail_url($thread):
      if ($authuser | test("^[A-Za-z0-9._+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$")) then
        "https://mail.google.com/mail/u/0/?authuser=\($authuser | @uri)#all/\($thread)"
      else
        "https://mail.google.com/mail/u/0/#all/\($thread)"
      end;

    ($labelmap[0] // {}) as $names
    | def mine: [ .[] | $names[.] | select(. != null) ];

    ($cache[0] // {}) as $c
    | {
        ok: true,
        email: $email,
        unread: $unread,
        searchUrl: $search,
        nextPage: $next,
        thisPage: $current,
        messages: [
          $ids[]
          | . as $id
          | ($c[$id] // {}) as $m
          | ($m.threadId // $id) as $thread
          | {
              id: $id,
              threadId: $thread,
              subject: ((($m.subject // "") | entity) as $s
                        | if ($s | length) > 0 then $s else "(no subject)" end),
              from: (($m.from // "") | entity | sender),
              snippet: (($m.snippet // "") | entity),
              ts: (($m.ts // 0) / 1000 | floor),
              labels: (($m.lab // []) | mine),
              url: mail_url($thread)
            }
        ]
      }'
}

cmd_list() {
  local token="" max page all_ids ids next unread email listed

  while [ $# -gt 0 ]; do
    case "$1" in
      --page) shift; token="${1:-}" ;;
      --limit) shift; export YOU_GOT_MAIL_MAX="${1:-25}" ;;
    esac
    shift
  done
  case "$token" in *[!A-Za-z0-9_-]*) token="" ;; esac

  max="$(max_messages)"
  gws_list page users messages list --params "$(
    jq -nc --arg q "$QUERY" --argjson n "$max" --arg t "$token" \
      '{userId:"me",q:$q,maxResults:$n} + (if $t == "" then {} else {pageToken:$t} end)')"
  all_ids="$(printf '%s' "$page" | jq -c '[.messages[]? | objects | .id | strings | select(test("\\A[0-9a-f]{1,32}\\z"))]' 2>/dev/null)"
  [ -n "$all_ids" ] || all_ids='[]'
  # Counted whole, for the unread total; no more than were asked for are
  # looked up and shown, however many the reply holds.
  listed="$(printf '%s' "$all_ids" | jq 'length')"
  ids="$(printf '%s' "$all_ids" | jq -c --argjson n "$max" '.[0:$n]')"
  next="$(printf '%s' "$page" | jq -r '.nextPageToken // empty' 2>/dev/null)"
  case "$next" in *[!A-Za-z0-9_-]*) next="" ;; esac

  unread_total unread "$listed" "$next" "$token"
  email="$(account_email)"
  case "$?" in
    0) ;;
    "$NOT_SAVED") fail_not_saved ;;
    *) email="" ;;
  esac

  ensure_json_object "$CACHE_FILE"
  ensure_json_object "$LABEL_FILE"
  fill_cache "$ids"
  fill_labels_from_cache "$ids" || fail_not_saved
  fail_if_too_large
  render "$ids" "$unread" "$email" "$next" "$token"
}

cmd_read() {
  local id="${1:-}"
  valid_id "$id" || die "not a message id"
  gws_gmail users messages modify \
    --params "$(jq -nc --arg id "$id" '{userId:"me",id:$id}')" \
    --json '{"removeLabelIds":["UNREAD"]}' >/dev/null || die "could not mark as read"
  printf '{"ok":true}\n'
}

fail_read_all() {
  printf '{"ok":false,"marked":%s,"error":%s}\n' "$1" "$(printf '%s' "$2" | jq -Rs .)"
  exit 0
}

cmd_read_all() {
  local token="" page ids next all='[]' seen='|' marked=0 chunk n total i

  while :; do
    [ "${SECONDS:-0}" -gt 90 ] && fail_read_all 0 "timed out collecting unread mail"
    gws_list page users messages list --params "$(
      jq -nc --arg q "$QUERY" --argjson n 500 --arg t "$token" \
        '{userId:"me",q:$q,maxResults:$n} + (if $t == "" then {} else {pageToken:$t} end)')"
    ids="$(printf '%s' "$page" | jq -c '[.messages[]? | objects | .id | strings | select(test("\\A[0-9a-f]{1,32}\\z"))]' 2>/dev/null)"
    [ -n "$ids" ] || ids='[]'
    # Through stdin: the collected ids outgrow what one argument can carry.
    all="$(printf '%s\n%s\n' "$all" "$ids" | jq -cs '(.[0] + .[1]) | unique')" \
      || fail_read_all "$marked" "could not collect unread mail"
    next="$(printf '%s' "$page" | jq -r '.nextPageToken // empty' 2>/dev/null)"
    case "$next" in *[!A-Za-z0-9_-]*) next="" ;; esac
    [ -z "$next" ] && break
    case "$seen" in
      *"|$next|"*) die "gmail repeated a page token" ;;
    esac
    seen="${seen}${next}|"
    token="$next"
  done

  total="$(printf '%s' "$all" | jq 'length')"
  i=0
  while [ "$i" -lt "$total" ]; do
    [ "${SECONDS:-0}" -gt 100 ] && fail_read_all "$marked" "timed out marking mail as read"
    chunk="$(printf '%s' "$all" | jq -c --argjson i "$i" '.[$i:$i+1000]')"
    n="$(printf '%s' "$chunk" | jq 'length')"
    if ! gws_gmail users messages batchModify \
      --params '{"userId":"me"}' \
      --json "$(jq -nc --argjson ids "$chunk" '{ids:$ids,removeLabelIds:["UNREAD"]}')" \
      >/dev/null
    then
      fail_read_all "$marked" "could not mark as read"
    fi
    marked=$((marked + n))
    i=$((i + 1000))
  done
  printf '{"ok":true,"marked":%s}\n' "$marked"
}

case "${1:-list}" in
  list) shift; cmd_list "$@" ;;
  read) cmd_read "${2:-}" ;;
  read-all) cmd_read_all ;;
  *)    die "unknown command" ;;
esac
