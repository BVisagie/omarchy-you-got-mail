{
  "schemaVersion": 1,
  "id": "bvisagie.you-got-mail",
  "name": "You've Got Mail",
  "version": "2.9.0",
  "author": "BVisagie",
  "description": "Unread-only mailbox for Gmail, Outlook, Fastmail, IMAP, and HEY. One pile across accounts; click a row to open it.",
  "homepage": "https://github.com/BVisagie/omarchy-you-got-mail",
  "license": "MIT",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "You've Got Mail",
    "description": "A mailbox whose flag raises for unread mail from Gmail, Outlook, Fastmail, IMAP, and HEY. Click a row to open it.",
    "category": "Apps",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "max": 25,
      "refreshIntervalSec": 60,
      "soundEnabled": false,
      "soundCooldownSec": 60,
      "soundVolume": 100,
      "soundFile": ""
    },
    "schema": [
      {
        "key": "max",
        "type": "integer",
        "label": "Page size",
        "min": 1,
        "max": 50,
        "step": 1,
        "defaultValue": 25
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 60
      },
      {
        "key": "soundEnabled",
        "type": "boolean",
        "label": "Sound on new mail",
        "description": "Play \"You've got mail!\" when new unread mail arrives.",
        "defaultValue": false
      },
      {
        "key": "soundCooldownSec",
        "type": "integer",
        "label": "Sound cooldown (seconds)",
        "min": 0,
        "max": 3600,
        "step": 15,
        "defaultValue": 60
      },
      {
        "key": "soundVolume",
        "type": "integer",
        "label": "Sound volume",
        "min": 0,
        "max": 100,
        "step": 1,
        "defaultValue": 100
      },
      {
        "key": "soundFile",
        "type": "path",
        "label": "Sound file",
        "description": "Optional. Leave empty for the bundled clip.",
        "defaultValue": ""
      }
    ]
  }
}
